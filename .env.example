# ==========================================================
# AI Bill & Subscription Waste Detector - Environment Config
# ==========================================================
# Copy this file to ".env" and fill in real values.
# Never commit your real ".env" file to GitHub.

# ---- Database ----
# Default is SQLite (a local file, no setup needed).
DATABASE_URL=sqlite:///database/app.db

# ---- Generative AI (optional feature) ----
# If left empty, the app runs normally but the "AI Insights"
# page will show a friendly "AI disabled" message instead of
# crashing. Get a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=

# Which LLM provider to use. Currently supported: "gemini"
LLM_PROVIDER=gemini

# Model name (kept configurable so it's easy to swap later)
LLM_MODEL_NAME=gemini-1.5-flash

# Timeout (seconds) for any call to the LLM API
LLM_TIMEOUT_SECONDS=20

# ---- File Upload Limits ----
# Max upload size in megabytes
MAX_UPLOAD_SIZE_MB=15

# ---- OCR ----
# Path to the Tesseract executable on Windows, e.g.
# C:\Program Files\Tesseract-OCR\tesseract.exe
# Leave empty on Mac/Linux if tesseract is already on PATH.
TESSERACT_CMD_PATH=

# ---- App Behavior ----
# Currency symbol used for display (this project defaults to INR)
CURRENCY_SYMBOL=₹

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
